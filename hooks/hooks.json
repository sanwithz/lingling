{
  "description": "ให้ Claude ปิดท้ายคำตอบด้วยบรรทัดสรุป แล้วอ่านออกเสียงเป็นภาษาเดียวกับที่ตอบ (ไทย/อังกฤษ)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/tai24/AppData/Local/Programs/Python/Python313/python.exe",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/secretary.py", "--mode", "inject"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/tai24/AppData/Local/Programs/Python/Python313/python.exe",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/secretary.py", "--mode", "stop"],
            "async": true,
            "statusMessage": "กำลังอ่านสรุปให้ฟัง..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/tai24/AppData/Local/Programs/Python/Python313/python.exe",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/secretary.py", "--mode", "notify"],
            "async": true
          }
        ]
      }
    ]
  }
}
